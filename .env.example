# Copy to .env and fill in. Nothing here is required for the site to run,
# but the contact / careers forms need at least one delivery channel.

# POST endpoint that accepts JSON { name, email, company, service, budget, message, topic }.
# e.g. a Formspree / Basin / own API URL. Takes priority over e-mail.
VITE_CONTACT_ENDPOINT=

# Fallback: the form opens the visitor's e-mail client addressed to this inbox.
VITE_CONTACT_EMAIL=

# Optional — shown on the Contact page and footer only when set.
VITE_CONTACT_PHONE=
VITE_CONTACT_ADDRESS=
